# Optional. Analytics is disabled by default.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Marketing measurement. Leave disabled until accounts, masking and GA4 settings are verified.
# GA4 and Clarity load directly. Do not also install their tags inside GTM.
NEXT_PUBLIC_ENABLE_MARKETING_ANALYTICS=false
NEXT_PUBLIC_GTM_ID=GTM-MDZ4RQQQ
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Local/preview QA only. Keep false in production.
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Optional tokens from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Server only: Resend API key and verified sender. Never use NEXT_PUBLIC_ for these.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=support.jovamedia@gmail.com

# Required: Google reCAPTCHA v2 checkbox. Never expose the secret in NEXT_PUBLIC_.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional exact hostnames for local/preview checks; production is restricted to JovaMedia.
RECAPTCHA_ALLOWED_HOSTNAMES=jovamedia.com,www.jovamedia.com

# Resource delivery and confirmed newsletter signup (server-only)
RESOURCE_FROM_EMAIL=
SITE_URL=https://www.jovamedia.com
NEWSLETTER_TOKEN_SECRET=
RESEND_NEWSLETTER_SEGMENT_ID=

# Enable only after configuring the Resend newsletter.confirmed automation.
NEWSLETTER_AUTOMATION_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
