{
  "rewrites": [
    {
      "source": "/api/jovabook/:path*",
      "destination": "https://www.jovamedia.com/api/jovabook/:path*"
    },
    {
      "source": "/:salon((?!.*[/]$)(?!(?:www|app|admin|support|salon|api|bookings|book|mail|help|billing|status|blog|login|signup|dashboard|jova|jovamedia|jovabook|staging|test|demo|owner|operator|customer|auth|callback|recovery|reset|forgot|register|index|assets|fonts|images|scripts|styles|config|health|robots|favicon|sitemap|jova-demo)(?:/|$))(?=[a-z0-9-]{3,30}(?:/|$))[a-z0-9]+(?:-[a-z0-9]+)*)/:page(book(?:/(?:service|time|choice|details|payment|confirmation))?|account(?:/(?:login|register|forgot|reset|bookings|payments))?|about|contact)?",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
