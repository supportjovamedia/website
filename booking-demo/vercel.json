{
  "buildCommand": "node build-assets.mjs",
  "installCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/jovabook/:path*",
      "destination": "https://www.jovamedia.com/api/jovabook/:path*"
    },
    {
      "source": "/:salon((?!.*[/]$)(?!(?:www|app|admin|support|salon|api|bookings|book|mail|help|billing|status|blog|login|signup|dashboard|jova|jovamedia|jovabook|staging|test|demo|owner|operator|customer|auth|callback|recovery|reset|forgot|register|index|assets|fonts|images|scripts|styles|config|health|robots|favicon|sitemap|jova-demo)(?:/|$))(?=[a-z0-9-]{3,30}(?:/|$))[a-z0-9]+(?:-[a-z0-9]+)*)/:page(book(?:/(?:service|time|choice|details|payment|confirmation))?|account(?:/(?:login|register|forgot|reset|bookings|payments|profile))?|about|contact)?",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.jovamedia.com"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|avif|gif|ico|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:salon((?!.*[/]$)(?!(?:www|app|admin|support|salon|api|bookings|book|mail|help|billing|status|blog|login|signup|dashboard|jova|jovamedia|jovabook|staging|test|demo|owner|operator|customer|auth|callback|recovery|reset|forgot|register|index|assets|fonts|images|scripts|styles|config|health|robots|favicon|sitemap|jova-demo)(?:/|$))(?=[a-z0-9-]{3,30}(?:/|$))[a-z0-9]+(?:-[a-z0-9]+)*)/:page(book(?:/(?:service|time|choice|details|payment|confirmation))?|account(?:/(?:login|register|forgot|reset|bookings|payments|profile))?|about|contact)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/operator.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:file((?:owner|operator)-(?:entry|app|styles)\\.[a-f0-9]{20}\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/supabase-2.117.3.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
